<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest. Apple reads this to build the App Store privacy label and to
  check the "required reason" APIs; without it an upload is rejected.

  What it has to match is the code, not the intent, so the mapping is spelled out
  here. Two tables leave the device, both insert-only and both keyed by the random
  per-install id in UserProfile.installId:

    user_profiles   install_id, household_size, trips_per_week, weekly_budget,
                    diet_tags, plz, branch_ids  (only after the consent step)
    match_feedback  install_id, query, product_title, market, match_kind,
                    reason, comment

  A third flow, Kochen (Edge Function `gerichte`), only after its own consent
  sheet: the typed dish text or the shopping list entries' text, plus offer
  terms, go through our server to Anthropic (Claude) and come back as dishes.
  Nothing of it is stored on our side; the rate-limit counter keeps a SHA-256
  of the install id for two days. Declared below as OtherUserContent (list
  entries) and SearchHistory (the typed dish), purpose AppFunctionality —
  both types were already declared for match_feedback, so the list of types
  does not change, only what feeds them.

  First name never leaves the phone; the shopping list only via Kochen. There is no account and
  no device identifier, which is why everything below is declared as *not* linked
  to the user's identity — the rows can be joined to each other, not to a person.

  Only one required-reason API is in use: UserDefaults, for the app's own data.
  SwiftData, CoreLocation and the rest are not on Apple's list, and the app links
  no third-party SDK, so no other manifest has to be merged in.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- install_id: random per installation, not derived from the device. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- plz and branch_ids. Postcode-level at best, never coordinates. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- match_feedback.query: the word off the shopping list that produced
		     the wrong match. Declared as search history because that is what it
		     functionally is, even though the user typed it as a list entry.
		     Also the dish typed into Kochen ("Lasagne für 4"), sent to Anthropic. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeSearchHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- match_feedback.comment: free text, so anything can end up in it.
		     Kochen sends the shopping list entries (free text as well) to
		     Anthropic — same type, purpose AppFunctionality.
		     Steht in derselben Zeile wie das Suchwort darüber und wird in der
		     Pflegerunde zusammen mit ihm gelesen — also derselbe Zweck, auch
		     wenn nur eines der beiden Felder nach „Suche" aussieht. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- household_size, trips_per_week, weekly_budget, diet_tags. Apple has
		     no bucket for household or dietary preferences. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- CA92.1 = the app reads and writes its own defaults, nothing shared. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
